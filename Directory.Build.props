<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>2.0.2</Version>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
    <RepositoryUrl>https://github.com/RushuiGuan/http</RepositoryUrl>
    <PackageProjectUrl>https://rushuiguan.github.io/http/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Rushui Guan</Authors>
    <PackageTags>
    </PackageTags>
    <PackageReleaseNotes>See https://rushuiguan.github.io/http/release-notes</PackageReleaseNotes>
    <!-- SourceLink Configuration -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>